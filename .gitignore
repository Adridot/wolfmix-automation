.DS_Store
__pycache__/
.git-rewrite/
*.pyc
*.err

# Runtime state of the device experiment runner: controller snapshots, run
# journals, DMX captures. Local only, never published.
.wolfmix-state/

# No Wolfmix project or library file is distributed with this repository.
# They carry manufacturer content (factory presets, fixture profiles) and the
# operator's own show data. See docs/corpus.md.
*.wpj
*.wm
*.wmx
corpus/**/dmx/
research/vendor/

# Fixture profiles, in either state: a `.ssl2` from the vendor's library and
# the XML decrypted from it are the same content, and neither is ours to
# publish. Our own generated fixtures are ignored too — the JSON description
# they are built from is what belongs in the tree (LEGAL.md, `tools/ssl2.py`).
*.ssl2
*.ssl2.xml

# Liste locale des noms réels interdits (tools/wpj_privacy.py).
.wpj-private-names

# Vendor documents and binaries kept locally for reference, never committed.
*.pdf

# Flash images and firmware bundles: the manufacturer's, or a patched copy of
# it. Prepared and verified locally, never distributed (LEGAL.md).
**/wm-fw-bundle*/
**/wolfmixFlash*.bin
**/wolfmixFirmware*.bin
**/flash-custom.bin
**/flash-custom.bin.json

# OpenSpec (npx @fission-ai/openspec init --tools claude) : outillage local
# de développement piloté par spec, pas du contenu du dépôt.
.claude/
openspec/
